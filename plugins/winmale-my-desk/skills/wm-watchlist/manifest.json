{
  "id": "wm-watchlist",
  "name": "我的关注列表",
  "version": "0.3.0",
  "tier": 1,
  "visibility": "opt_in",
  "l1_family": "user_asset",
  "asset_domain": "watchlist",
  "description": "查看或整理我的关注列表：名称、分组、买卖点与备注、分组盘中提醒。加/删/分组用增量；整理前默认预览。统一跨市场 SoT。",
  "inputs_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "view",
          "add",
          "remove",
          "group_add",
          "group_remove",
          "group_create",
          "group_rename",
          "group_delete",
          "annotate",
          "alert_enable",
          "alert_disable",
          "organize"
        ],
        "default": "view"
      },
      "market": {
        "type": "string",
        "enum": [
          "cn",
          "hk",
          "us",
          "all",
          ""
        ],
        "description": "可选；写可空（按代码推断）；view 可空/all 全量；cn|hk|us 为投影或写 hint"
      },
      "symbol": {
        "type": "string"
      },
      "symbols": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "cascade": {
        "type": "boolean",
        "default": true,
        "description": "action=remove 时是否同步踢出各分组；默认 true"
      },
      "group_id": {
        "type": "string"
      },
      "group_name": {
        "type": "string"
      },
      "buy_price": {
        "type": "number",
        "description": "action=annotate 买点绝对价；省略保留现值；0=清除"
      },
      "sell_price": {
        "type": "number",
        "description": "action=annotate 卖点绝对价；省略保留现值；0=清除"
      },
      "note": {
        "type": "string",
        "description": "action=annotate 标的备注，最长 80 字；省略保留现值；空=清除"
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "可选指标码（标注用）；默认内置 PE/ROE/涨跌等"
      },
      "organize_plan": {
        "type": "object",
        "description": "action=organize 时的目标全量快照（对齐 watchlist.apply）"
      },
      "dry_run": {
        "type": "boolean",
        "default": true
      },
      "confirm": {
        "type": "boolean",
        "default": false
      },
      "allow_removals": {
        "type": "boolean",
        "default": false,
        "description": "organize 含删除时须用户明确允许"
      }
    }
  },
  "runtime": {
    "mode": "skill_run",
    "script_ref": "scr_wm_watchlist",
    "path": "xs/skillhub/wm_watchlist.xs"
  },
  "required_scopes": [
    "analysis:skills:run",
    "user:watchlist:read"
  ],
  "required_scopes_by_action": {
    "add": [
      "user:watchlist:write"
    ],
    "remove": [
      "user:watchlist:write"
    ],
    "group_add": [
      "user:watchlist:write"
    ],
    "group_remove": [
      "user:watchlist:write"
    ],
    "group_create": [
      "user:watchlist:write"
    ],
    "group_rename": [
      "user:watchlist:write"
    ],
    "group_delete": [
      "user:watchlist:write"
    ],
    "annotate": [
      "user:watchlist:write"
    ],
    "alert_enable": [
      "user:watchlist:write",
      "user:reminder:write"
    ],
    "alert_disable": [
      "user:watchlist:write",
      "user:reminder:write"
    ],
    "organize": [
      "user:watchlist:write"
    ]
  },
  "icon": "关",
  "category": "组合与跟踪",
  "author": "赢麻了官方",
  "official": true,
  "summary": "查看或整理我的关注列表（名称、分组、买卖点/备注与分组提醒）。",
  "sample_prompts": [
    "看看我的关注列表里有什么。",
    "把某某加进关注列表。",
    "给茅台设个买点和备注。",
    "打开重点关注分组的买卖点提醒。",
    "整理一下我的关注分组。"
  ],
  "expertise_tags": [
    "关注列表"
  ],
  "outputs_schema": {
    "type": "object",
    "x-envelope": "skills_run",
    "description": "Body = data.result (XS return). HTTP prefix: data.result.",
    "x-primary_path": "holdings",
    "properties": {
      "action": {
        "type": "string"
      },
      "holdings": {
        "type": "array",
        "description": "HTTP: data.result.holdings (view)"
      },
      "groups": {
        "type": "array"
      },
      "apply": {
        "type": "object",
        "description": "HTTP: data.result.apply (writes)"
      },
      "diff": {
        "type": "object"
      },
      "deeplinks": {
        "type": "array"
      },
      "response_guide": {
        "type": "string"
      },
      "error": {
        "type": "string"
      }
    }
  }
}
